# ─────────────────────────────────────────────────────────────
# EDTIB控制中台 环境变量模板（复制为 .env.local 后填入真实值；.env.local 已被 .gitignore 忽略）
#
# 分为两组：
#   A. 前端（Vite，VITE_ 前缀）：编译进渲染层产物
#   B. 桌面端 Rust（TAURI_ 前缀）：运行期读取，进程环境变量优先，
#      其次读密钥文件 <AppData>/console.env（可用 EDTIB_ENV_FILE 指定绝对路径）
#      —— 打包后的应用从 Finder / 快捷方式启动不会继承 shell 环境，
#         因此生产分发请写入 console.env，由首次启动前放置。
#
# ⚠️ 两套密钥，职责不同，不要混用：
#   · A 组 VITE_APP_*  ↔  B 组 TAURI_LINK_*：「本地链路对」（渲染层 ↔ tauri http 服务），
#     必须是同一对——渲染层用它加密请求体、算 App-Secret / X-Sign，tauri 用它验签并加解密回包；
#     不一致直接 4016000305。
#   · B 组 TAURI_APP_* + TAURI_APP_BASE_URL：tauri http 服务「出站调用后端网关」的凭证与地址，
#     属于后端密钥，禁止出现在渲染层产物里；正式口径为本地 secrets 表的有效行，环境变量仅作缺省兜底。
# ─────────────────────────────────────────────────────────────

# ============ A. 前端（Vite） ============
# [框架统一] 前端七键契约——三套环境文件必须成对齐全，books / console 结构一致：
#   VITE_APP_ID / VITE_APP_SECRET / VITE_APP_IV / VITE_APP_BASE_URL /
#   VITE_REQUEST_ENCRYPT / VITE_RETURN_ENCRYPT / VITE_ASSETS_BASE_URL
# 口径（命令决定使用哪个环境文件）：
#   npm run dev        → .env.development：浏览器直连接口服务（VITE_APP_BASE_URL 即被调用的接口地址），
#                        不经过 tauri http 服务，B 组 TAURI_* 不参与
#   npm run tauri:dev  → .env.test：渲染层只调用本地 tauri http 服务（VITE_APP_* = 本地链路密钥，
#                        需与 <AppData>/console.env 的 TAURI_LINK_* 同一对），
#                        再由 tauri 用 TAURI_APP_* 请求 TAURI_APP_BASE_URL 对应的服务
#   npm run build      → .env.production：与 tauri:dev 同样的代理链路，凭证换成正式一套

# 运行环境标识：development | test | production（禁止随意修改，多处逻辑据此分支）
VITE_USER_NODE_ENV=development

# 接口基础路径：浏览器直连模式下是被调用的接口服务地址；
# 桌面端（proxy 模式）下作为代理路径前缀，由 tauriAdapter 转 invoke('proxy_request')，
# 真实出站地址由 Rust 侧 TAURI_APP_BASE_URL / secrets 表 app_url 决定
VITE_APP_BASE_URL='/api'

# appId / appSecret（appSecret 必须 32 字符，AES-256 密钥）
# · .env.development（直连模式）：填被调用接口服务（网关）的凭证，浏览器直接与网关验签方约定
# · .env.test / .env.production（代理模式）：填「本地链路对」，必须与同文件 TAURI_LINK_* 完全一致，
#   网关凭证改用 TAURI_APP_*，不得编译进渲染层产物
VITE_APP_ID=
VITE_APP_SECRET=
# 16 字符固定 IV：仅用于解密老格式固定 IV 密文（新请求/回包一律随机 IV，格式 iv(hex):密文(hex)）
VITE_APP_IV=

# 请求体加密开关 / 回包解密开关（与网关 ResponseWrapper 约定一致，取值 'true' | 'false'）
VITE_REQUEST_ENCRYPT=true
VITE_RETURN_ENCRYPT=true

# 静态资源 CDN 前缀（头像等，缺省回落 '.'）
VITE_ASSETS_BASE_URL=

# 第三方商业构建插件授权码（缺失时仅告警，不阻塞构建；正式发布请补齐）
VITE_APP_GITHUB_USER_NAME=
VITE_APP_SECRET_KEY=

# 构建 banner 里的更新时间（build/banner 读取，缺省按构建当天）
VITE_APP_UPDATE_TIME=

# ============ B. 桌面端 Rust（TAURI_ 前缀，运行期读取，不进前端产物） ============
# [框架统一] 前缀约定与 books 一致：
#   TAURI_LINK_* = 本地链路凭证（渲染层 ↔ tauri http 服务），可存放于 console.env 密钥文件；
#   TAURI_APP_*  = tauri http 服务出站调用后端网关的凭证与地址（secrets 表缺省兜底），同样可入密钥文件；
#   EDTIB_*      = 与密钥无关的运行时配置（密钥文件路径、更新源、版本串）。
# 环境不再由编译类型决定，而是由「当前生效的环境文件」决定：
#   npm run tauri:dev 经 scripts/with-tauri-env.mjs 加载 .env.test 后注入进程；
#   打包后的应用读 <AppData>/console.env（正式一套）。EDTIB_DEV_* / EDTIB_PROD_* 已废弃。

# 本地链路凭证：与 .env.test / .env.production 里的 VITE_APP_ID / VITE_APP_SECRET 完全相同
# TAURI_LINK_IV 为 16 字符：用于解密「老格式固定 IV」密文，同时是回包是否加密的开关
#（回包本身按新约定输出随机 IV，格式 iv(hex):密文(hex)）
TAURI_LINK_ID=
TAURI_LINK_SECRET=
TAURI_LINK_IV=

# 本地库字段级加密（secrets 表 app_secret / app_iv 落库加密）。
# 可留空：留空时由 TAURI_LINK_SECRET 经 sha256 派生（32 / 16 字符）
TAURI_FIELD_CRYPT_SECRET=
TAURI_FIELD_CRYPT_IV=

# 出站网关凭证：tauri http 服务调用后端接口时使用。
# 取值优先级：本地 secrets 表有效行（status=1）> 这里的环境变量 / 密钥文件。
# 注意（2026-10 加固后的口径）：
#   · 源码里不再内置任何 dev/prod 兜底地址。TAURI_APP_BASE_URL 与 secrets.app_url
#     同时缺失时，代理直接以「缺少出站网关地址」失败，不会静默挑一个网关；
#   · 两者都配置时必须同源，否则按「配置网关地址与本地 secrets.app_url 不一致」拒绝转发；
#   · 正式包（release 构建）只允许出网到 config::ALLOWED_GATEWAY_ORIGINS 列出的自有域名；
#   · 开发/测试构建（tauri:dev）默认拒绝访问正式网关，确需联调正式环境时显式设
#     EDTIB_ALLOW_PROD_EGRESS=1（与 with-tauri-env.mjs 的 EDTIB_TAURI_ALLOW_PROD_ENV 同一口径）；
#   · 正式网关凭证不要写进本仓库的任何 .env*：产物扫描（npm run scan:dist）会把
#     出现在 .env* 里的 TAURI_APP_* 视为应进入密钥文件的值，出现进 Web 资源即构建失败。
TAURI_APP_ID=
TAURI_APP_SECRET=
TAURI_APP_IV=
TAURI_APP_BASE_URL=https://gateway-dev.edtib.com/api
# 开发期联调正式网关的显式放行开关（默认关闭，正式包不需要）
# EDTIB_ALLOW_PROD_EGRESS=1

# 密钥文件路径覆盖（默认 <AppData>/console.env）
# EDTIB_ENV_FILE=/absolute/path/to/console.env

# tauri:dev 的环境来源（默认 .env.test）。指向 .env.production / .env.stage 会被
# with-tauri-env.mjs 拒绝，除非同时设置 EDTIB_TAURI_ALLOW_PROD_ENV=1
# EDTIB_TAURI_ENV=.env.test

# 由 with-tauri-env.mjs 在 tauri:dev 时设为 development；
# 它同时决定 Rust 侧的白名单口径（正式包不读此变量）
# NODE_ENV=development

# ============ 打包 / 更新 ============

# 更新产物签名私钥（Tauri updater）。路径指向本机 ~/.tauri/EdtibConsole-updater.key
# 生成密钥：npm run tauri -- signer generate -p 密码 -w ~/.tauri/EdtibConsole-updater.key
TAURI_SIGNING_PRIVATE_KEY_PATH="~/.tauri/EdtibConsole-updater.key"
# 私钥密码（生成密钥时设置的密码）
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=

# 方式二（备用）：内联私钥内容——仅当第三方 CI 不支持 PATH 形式时启用：
# 1) 注释掉上面的 PATH 行  2) 取消下行注释并粘贴 ~/.tauri/EdtibConsole-updater.key 全文
# export TAURI_SIGNING_PRIVATE_KEY="
# （密钥文件全文，含首行 untrusted comment）
# "

# 更新清单地址覆盖（逗号/分号分隔，优先级高于 tauri.conf.json 的 plugins.updater.endpoints）
# 注意：Tauri 更新器需要 latest.json 清单（platforms.<target>.url/signature），
#       与老 electron-updater 的 latest.yml 不是同一份文件
# EDTIB_UPDATER_ENDPOINT=https://static.edtib.com/update/console/latest.json

# 版本展示串（可选，构建期注入）：配置后 get_app_version 返回 `{alias}-v{version}({timer})`，
# 未配置则返回纯版本号
# EDTIB_VERSION_ALIAS=控制台
# EDTIB_VERSION_TIMER=2026-10-01

{
  "name": "edtib-console",
  "version": "1.0.0",
  "private": true,
  "author": "trexwb",
  "description": "EDTIB控制中台（Tauri v2 桌面客户端）",
  "scripts": {
    "dev": "VITE_CONFIG_NATIVE_IGNORE_WARNING=true vite --mode development",
    "dev:test": "VITE_CONFIG_NATIVE_IGNORE_WARNING=true vite --mode test",
    "dev:vue-tsc": "VITE_CONFIG_NATIVE_IGNORE_WARNING=true vue-tsc --noEmit && VITE_CONFIG_NATIVE_IGNORE_WARNING=true vite --mode development",
    "typecheck": "vue-tsc --noEmit",
    "production": "NODE_OPTIONS=--max-old-space-size=4096 NODE_ENV=production VITE_CONFIG_NATIVE_IGNORE_WARNING=true vite build --mode production && node scripts/scan-dist-secret.mjs",
    "build": "npm run vite:build && npm run tauri:build && npm run make-dmg && node scripts/scan-installer-secret.mjs",
    "vite:build": "NODE_OPTIONS=--max-old-space-size=4096 VITE_CONFIG_NATIVE_IGNORE_WARNING=true vite build --mode production && node scripts/scan-dist-secret.mjs",
    "build:check": "vue-tsc --noEmit && npm run vite:build",
    "scan:dist": "node scripts/scan-dist-secret.mjs",
    "scan:installer": "node scripts/scan-installer-secret.mjs",
    "preview": "VITE_CONFIG_NATIVE_IGNORE_WARNING=true vite preview",
    "tauri": "tauri",
    "tauri:dev": "node scripts/with-tauri-env.mjs tauri dev",
    "tauri:build": "node scripts/with-updater-key.mjs tauri build",
    "make-dmg": "bash scripts/make-dmg.sh",
    "postinstall": "node ./install.js && node scripts/patch-typescript.mjs",
    "lint": "eslint  */**/*.{vue,js,ts} --fix",
    "lint:eslint": "eslint {src,mock,library,types}/**/*.{vue,js,ts} --fix",
    "lint:prettier": "prettier {src,mock,library,types}/**/*.{html,vue,css,sass,scss,js,ts,md} --write",
    "lint:stylelint": "stylelint {src,mock,library}/**/*.{vue,css,sass,scss} --fix --cache --cache-location node_modules/.cache/stylelint/",
    "module:install": "npm install",
    "module:update": "ncu -u --reject vite-plugin-mock --registry https://registry.npmmirror.com&&npm run module:install",
    "module:reinstall": "rimraf node_modules&&npm run module:install",
    "generate-pwa-assets": "pwa-assets-generator",
    "template": "plop",
    "version:set": "node scripts/bump-version.mjs",
    "version:patch": "node scripts/bump-version.mjs --patch",
    "version:check": "node scripts/check-version.mjs"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@kangc/v-md-editor": "^2.3.15",
    "@logicflow/core": "^2.2.5",
    "@logicflow/extension": "^2.3.1",
    "@lucky-canvas/vue": "^0.1.11",
    "@opentiny/vue": "^3.32.0",
    "@tauri-apps/api": "^2.12.3",
    "@tauri-apps/plugin-opener": "^2.7.1",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.13.3",
    "@vueuse/core": "^15.0.0",
    "@vueuse/head": "^2.0.0",
    "@vxe-ui/core": "^4.4.28",
    "@wangeditor/editor": "^5.1.23",
    "@wangeditor/editor-for-vue": "^5.1.12",
    "axios": "^1.20.0",
    "crypto-js": "^4.2.0",
    "dayjs": "^1.11.23",
    "echarts": "^6.1.0",
    "element-plus": "2.14.7",
    "esbuild": "^0.28.2",
    "glob": "^13.0.6",
    "intro.js": "^8.6.0",
    "jsdom": "^30.1.2",
    "jsencrypt": "^3.5.4",
    "json-schema-editor-vue3": "^1.2.0",
    "lodash-es": "^4.18.1",
    "mathjs": "^15.2.0",
    "mitt": "^3.0.1",
    "mockjs": "^1.1.0",
    "normalize.css": "^8.0.1",
    "nprogress": "^0.2.0",
    "pinia": "^4.0.3",
    "pinia-plugin-persistedstate": "^4.7.1",
    "qs": "^6.16.0",
    "sass": "1.105.1",
    "typeit": "^8.8.7",
    "vsv-icon": "^2.2.7",
    "vue": "^3.5.43",
    "vue-echarts": "^8.3.2",
    "vue-i18n": "^11.4.14",
    "vue-json-viewer": "^3.0.4",
    "vue-pdf-embed": "^2.1.7",
    "vue-qr": "^5.0.3",
    "vue-router": "^5.4.0",
    "vue-virtual-scroller": "^3.0.5",
    "vue3-gantt": "1.1.8-7",
    "vue3-puzzle-vcode": "^1.1.7",
    "vuedraggable": "^4.1.0",
    "vxe-table": "^4.22.3",
    "xe-utils": "^4.1.2",
    "xgplayer": "^3.0.26",
    "xgplayer-hls.js": "^3.0.26",
    "xlsx": "^0.18.5",
    "xlsx-js-style": "^1.2.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.2",
    "@types/crypto-js": "^4.2.2",
    "@types/jsdom": "^30.0.0",
    "@types/lodash-es": "^4.17.12",
    "@types/mockjs": "^1.0.10",
    "@types/nprogress": "^0.2.3",
    "@types/qs": "^6.15.1",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "@vue/compiler-sfc": "^3.5.43",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "autoprefixer": "^10.6.1",
    "chokidar": "^5.0.0",
    "eslint": "^10.12.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "lint-staged": "^17.6.0",
    "picocolors": "^1.1.1",
    "plop": "^4.0.5",
    "postcss-html": "^2.0.0",
    "prettier": "^3.9.10",
    "rollup-plugin-replace": "^2.2.0",
    "rollup-plugin-visualizer": "^7.1.1",
    "stylelint": "^17.16.0",
    "stylelint-config-recess-order": "^7.8.0",
    "stylelint-config-recommended-scss": "^17.0.1",
    "stylelint-config-recommended-vue": "^2.0.0",
    "terser": "^5.51.2",
    "typescript": "~6.0.3",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.3.4",
    "vite-plugin-banner": "^0.8.1",
    "vite-plugin-mock": "3.0.2",
    "vite-plugin-pwa": "^2.0.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vite-plugin-svg-icons": "^2.0.1",
    "vite-plugin-unplugin": "^1.8.0",
    "vite-plugin-vitebar": "^0.0.8",
    "vue-global-api": "^0.4.1",
    "vue-tsc": "^3.3.13"
  },
  "homepage": "https://edtib.com/",
